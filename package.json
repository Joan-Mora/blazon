{
  "name": "blazon",
  "private": true,
  "version": "0.1.0",
  "description": "Blazon — Org OS for competitive esports organizations",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "pnpm --filter @blazon/db migrate:dev",
    "db:seed": "pnpm --filter @blazon/db seed",
    "db:generate": "pnpm --filter @blazon/db generate"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
